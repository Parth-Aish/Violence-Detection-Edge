# ═══════════════════════════════════════
# Violence Detection System — .gitignore
# ═══════════════════════════════════════

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# YOLOv8 & ST-GCN model weights
*.pt
*.onnx
!backend/yolov8n-pose.onnx
!backend/models/violence_stgcn.onnx
!backend/models/violence_stgcn.onnx.data
!backend/violence_stgcn.onnx
!backend/violence_stgcn.onnx.data
*.engine
runs/

# Training artifacts and dataset downloads
/data/
*.npy
kaggle.json
**/kaggle.json

# Data (generated at runtime)
backend/data/*.db
backend/data/*.jsonl
backend/data/*.db-wal
backend/data/*.db-shm

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
